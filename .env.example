# Base de données PostgreSQL
POSTGRES_USER=audit
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=audit

# Sécurité backend (générer une valeur aléatoire longue, ex: openssl rand -hex 32)
SECRET_KEY=change-me-generate-a-random-secret

# Port d'écoute de l'application sur la machine hôte
HTTP_PORT=8080

# Origines autorisées par l'API (JSON). À adapter à l'URL réelle de l'application.
CORS_ORIGINS=["http://localhost:8080"]

# Compte administrateur créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@pilotage-audit.local
ADMIN_PASSWORD=change-me-strong-password

# SSO / OIDC (optionnel - laisser vide si non utilisé)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=



# Options avancées (valeurs par défaut du backend si non renseignées)
# Durée de validité d'un jeton de session, en minutes (8 h par défaut)
#ACCESS_TOKEN_EXPIRE_MINUTES=480
# Taille maximale d'un fichier déposé, en Mo (documents et imports)
#MAX_UPLOAD_SIZE_MB=50

# Miroir de paquets privé (optionnel — vide = registres publics)
#DOCKER_BASE_REGISTRY=
#PIP_INDEX_URL=
#PIP_TRUSTED_HOST=
#NPM_REGISTRY=
# Mettre à false uniquement si le certificat du miroir npm n'est pas dans l'image
#NPM_STRICT_SSL=true
